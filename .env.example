# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_DATA_TIER: Set to "paid" only after this key's Cloud project has an
# active billing account. Production refuses to start otherwise, and Curator
# blocks PDF/chat processing on unpaid projects because academic material can be sensitive.
GEMINI_DATA_TIER="unpaid"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# USER_NAME: Optional workspace owner name displayed in the interface.
USER_NAME=""

# VITE_GOOGLE_CLIENT_ID: Optional public OAuth client ID for Google sign-in.
# Create a Web application OAuth client in Google Cloud Console and add
# http://localhost:3000 as an authorized JavaScript origin for local development.
VITE_GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_ID: The same OAuth Web client ID, used server-side to verify
# Google ID tokens before a session is created.
GOOGLE_CLIENT_ID=""

# CURATOR_DATA_DIR: Local private application storage for SQLite and PDFs.
# Use managed database/object storage before horizontally scaling the app.
CURATOR_DATA_DIR=".data"

# Stripe credit checkout (optional). Configure a webhook for
# /api/billing/stripe-webhook.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay credit checkout (optional). Configure a webhook for
# /api/billing/razorpay-webhook.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
